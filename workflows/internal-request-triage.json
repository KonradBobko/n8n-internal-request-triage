    {
      "parameters": {
        "promptType": "define",
        "text": "=Create a concise, neutral summary of this already validated low-risk internal request.\n\nDo not approve, reject, change its route, invent facts, or give access, payment, supplier, or financial advice.\n\nRequest details:\n- Requester: {{ $json.requester }}\n- Request type: {{ $json.request_type }}\n- Description: {{ $json.description }}\n- Needed by: {{ $json.needed_by }}\n- Existing route: {{ $json.route }}\n\nReturn only a short summary of no more than two sentences.",
