    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const requiredFields = [\n  'requester',\n  'request_type',\n  'description',\n  'needed_by',\n];\n\nconst missingFields = requiredFields.filter((field) => {\n  return !$json[field] || $json[field].trim() === '';\n});\n\nconst sensitiveRequestTypes = [\n  'access_request',\n  'payment_request',\n  'supplier_request',\n];\n\nconst humanReviewRequired =\n  missingFields.length > 0 ||\n  sensitiveRequestTypes.includes($json.request_type);\n\nreturn {\n  json: {\n    ...$json,\n    missing_fields: missingFields,\n    request_complete: missingFields.length === 0,\n    human_review_required: humanReviewRequired,\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
