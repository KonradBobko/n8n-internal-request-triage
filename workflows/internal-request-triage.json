      "id": "cc74232d-dac3-43aa-be0f-23bdf1501cab",
      "name": "Normalize Incoming Request"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const requiredFields = [\n  'requester',\n  'request_type',\n  'description',\n  'needed_by',\n];\n\nconst missingFields = requiredFields.filter((field) => {\n  const value = $json[field];\n  return typeof value !== 'string' || value.trim() === '';\n});\n\nconst requestType =\n  typeof $json.request_type === 'string'\n    ? $json.request_type.trim()\n    : '';\n\nconst sensitiveRequestTypes = [\n  'access_request',\n  'payment_request',\n  'supplier_request',\n];\n\nconst knownRequestTypes = [\n  'information_request',\n  'access_request',\n  'payment_request',\n  'supplier_request',\n];\n\nconst unknownRequestType =\n  requestType !== '' &&\n  !knownRequestTypes.includes(requestType);\n\nconst humanReviewRequired =\n  missingFields.length > 0 ||\n  sensitiveRequestTypes.includes(requestType) ||\n  unknownRequestType;\n\nreturn {\n  json: {\n    ...$json,\n    request_type: requestType,\n    missing_fields: missingFields,\n    request_complete: missingFields.length === 0,\n    unknown_request_type: unknownRequestType,\n    human_review_required: humanReviewRequired,\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "50f1728d-f18d-419e-bdfb-3c6f33a7131b",
      "name": "Validate Request & Set Review Flag"
    },
